    {
      "name": "5. Inscrições & Participações",
      "item": [
        {
          "name": "Inscrever-se em Atividade",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201 && jsonData.participationId) {",
