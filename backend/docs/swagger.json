{
  "openapi": "3.0.0",
  "info": {
    "title": "EcoGest API Documentation",
    "description": "REST API specification for the EcoGest Eco-Schools project management platform. Author: Francisco Mesquita.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter the JWT token returned during Login in the format: `Bearer <token>`"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "coordinator",
              "secretary",
              "council_member",
              "user"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          }
        }
      },
      "Activity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "active",
              "completed"
            ]
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "type": "string"
          },
          "executionLocation": {
            "type": "string"
          },
          "executionNotes": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          }
        }
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "resources": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          }
        }
      },
      "Meeting": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "planning",
              "active",
              "finished"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "bronze",
              "silver",
              "gold",
              null
            ]
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/users/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticates a user with email and password, returning the JWT token.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "admin@escolas.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "refreshToken": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Incorrect credentials"
          },
          "429": {
            "description": "Too many login attempts. Attempt limit exceeded."
          }
        }
      }
    },
    "/users/refresh": {
      "post": {
        "summary": "Renew Access Token (Refresh Token)",
        "description": "Uses a valid refresh token to obtain a new access token and a new refresh token (rotation).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "example": "7c9f8d..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token renewed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "refreshToken": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Renewal token missing from request"
          },
          "401": {
            "description": "Invalid/expired refresh token or inactive user"
          }
        }
      }
    },
    "/users/logout-session": {
      "post": {
        "summary": "Logout via Refresh Token",
        "description": "Revokes the provided refresh token, securely terminating the associated persistent session.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "example": "7c9f8d..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session terminated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Session logged out successfully"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "summary": "Register New User",
        "description": "Creates a basic user account via public self-registration.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "João Silva"
                  },
                  "email": {
                    "type": "string",
                    "example": "joaosilva@escola.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "409": {
            "description": "Email already in use"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Get current profile",
        "description": "Returns the authenticated user object via the JWT token.",
        "responses": {
          "200": {
            "description": "Profile returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update current profile",
        "description": "Updates fields of the logged-in user's profile.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          }
        }
      }
    },
    "/activities": {
      "get": {
        "summary": "List public activities",
        "description": "Obtains activities filtered by status (e.g., planned, active, completed).",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of activities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Activity"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/activities/{id}": {
      "get": {
        "summary": "Get activity details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            }
          }
        }
      }
    },
    "/activities/{id}/participations": {
      "post": {
        "summary": "Register for activity",
        "description": "Registers the user or an external guest in the activity.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Visitante 1"
                  },
                  "email": {
                    "type": "string",
                    "example": "visitante@escola.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration confirmed"
          }
        }
      }
    },
    "/activities/{id}/executions": {
      "post": {
        "summary": "Register Activity Execution (Council)",
        "description": "Completes and archives the actual details of the activity.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "executionLocation",
                  "executionNotes"
                ],
                "properties": {
                  "executionLocation": {
                    "type": "string",
                    "example": "Jardim da Escola"
                  },
                  "executionNotes": {
                    "type": "string",
                    "example": "Foram plantadas 20 sementes com 15 participantes."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution registered and status set to completed"
          }
        }
      }
    },
    "/proposals": {
      "get": {
        "summary": "List proposals",
        "description": "Returns the proposals of the current project.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Proposal"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create activity proposal (Council Member)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "area",
                  "startDate"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Campanha Resíduos Zero"
                  },
                  "description": {
                    "type": "string",
                    "example": "Colocação de novos ecopontos coloridos"
                  },
                  "area": {
                    "type": "string",
                    "example": "Waste"
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "resources": {
                    "type": "string",
                    "example": "Ecopontos, folhetos"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Proposal sent"
          }
        }
      }
    },
    "/meetings": {
      "get": {
        "summary": "List Meetings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Meeting"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Meeting (Secretary/Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "date",
                  "project_id"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Reunião Geral Conselho de Eco-Escolas"
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "description": {
                    "type": "string",
                    "example": "Discussão e aprovação do Plano de Atividades"
                  },
                  "project_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Meeting created"
          }
        }
      }
    },
    "/meetings/{id}/documents": {
      "get": {
        "summary": "Get minutes and photos attached to the meeting",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of minutes and photos attached"
          }
        }
      },
      "post": {
        "summary": "Attach document/minute/photo (Secretary/Admin)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "document",
                  "type"
                ],
                "properties": {
                  "document": {
                    "type": "string",
                    "format": "binary"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "ata",
                      "foto",
                      "other"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Document attached"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "summary": "List Annual Projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Annual Project (Admin Only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "year"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Projeto Eco-Escolas 2026/2027"
                  },
                  "year": {
                    "type": "integer",
                    "example": 2027
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created"
          }
        }
      }
    },
    "/projects/{id}/coordinator": {
      "patch": {
        "summary": "Assign Coordinator (Admin Only)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id"
                ],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "example": "664c39..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Coordinator successfully assigned"
          }
        }
      }
    },
    "/audits/questions": {
      "get": {
        "summary": "List Environmental Audit questions",
        "description": "Returns the audit questionnaire structured by categories (Water, Energy, Waste).",
        "responses": {
          "200": {
            "description": "List of questions"
          }
        }
      }
    },
    "/audits/responses": {
      "post": {
        "summary": "Submit audit responses",
        "description": "Creates or updates answers to questions for the active annual project.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectId",
                  "responses"
                ],
                "properties": {
                  "projectId": {
                    "type": "string"
                  },
                  "responses": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "questionId",
                        "value"
                      ],
                      "properties": {
                        "questionId": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string",
                          "enum": [
                            "Sim",
                            "Parcialmente",
                            "Não"
                          ]
                        },
                        "comments": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Responses saved"
          }
        }
      }
    },
    "/audits/report/{projectId}": {
      "get": {
        "summary": "Audit Report",
        "description": "Displays response progress and average scores globally and by category.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistical report with scores"
          }
        }
      }
    },
    "/admin/dashboard": {
      "get": {
        "summary": "Admin Dashboard and MoM Incentives",
        "description": "Displays global aggregated counts of activities (total, active, completed), participations, proposals, and the MoM comparison array `monthlyStats`.",
        "responses": {
          "200": {
            "description": "Aggregated metrics"
          }
        }
      }
    },
    "/admin/backups": {
      "get": {
        "summary": "List backups (Admin Only)",
        "responses": {
          "200": {
            "description": "List of available backups"
          }
        }
      },
      "post": {
        "summary": "Create Manual Backup (Admin Only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "description"
                ],
                "properties": {
                  "description": {
                    "type": "string",
                    "example": "Backup de Segurança semanal"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Backup completed"
          }
        }
      }
    }
  }
}