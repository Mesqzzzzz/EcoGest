	"item": [
		{
			"name": "1. Autenticação & Utilizadores",
			"item": [
				{
					"name": "Registar Utilizador (Público)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Novo Membro Conselho\",\n    \"email\": \"conselho@escola.com\",\n    \"password\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "Permite o auto-registo de um novo utilizador na plataforma com o perfil básico (user) e no mínimo 6 caracteres de password."
					}
				},
				{
					"name": "Iniciar Sessão (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.token) {",
									"    pm.environment.set(\"jwt_token\", response.token);",
									"    console.log(\"Token JWT capturado com sucesso:\", response.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@escolas.com\",\n    \"password\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"login"
							]
						},
						"description": "Autentica o utilizador e guarda automaticamente o token JWT retornado na variável de ambiente `jwt_token`."
					}
				},
				{
					"name": "Obter Perfil Atual",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/users/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"me"
							]
						},
						"description": "Retorna os detalhes do utilizador autenticado pelo token JWT."
					}
				},
				{
					"name": "Atualizar Perfil Atual",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
